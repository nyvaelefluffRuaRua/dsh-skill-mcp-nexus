{
  "name": "dsh-skill-mcp-nexus",
  "version": "0.1.2",
  "description": "DSH 面板：在一个界面里统一管理 skill 与 MCP，支持全局/工作区/会话三层开关、别名备注、分组、悬停提示与自建 MCP 服务器。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./lib/*.js": "./lib/*.js"
  },
  "engines": {
    "node": ">=22.15.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "manifest-check.mjs",
    "selftest.mjs",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "skill",
    "mcp",
    "model-context-protocol"
  ],
  "license": "MIT",
  "author": "奈薇 (nyvaelefluffRuaRua) <https://github.com/nyvaelefluffRuaRua>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nyvaelefluffRuaRua/dsh-skill-mcp-nexus.git"
  },
  "homepage": "https://github.com/nyvaelefluffRuaRua/dsh-skill-mcp-nexus#readme",
  "bugs": {
    "url": "https://github.com/nyvaelefluffRuaRua/dsh-skill-mcp-nexus/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "^4.2.0"
  }
}

